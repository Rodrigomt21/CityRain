# Banco de dados — troque user, password e cityrain pelos seus valores reais
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cityrain

# Banco usado nos testes (nunca use o banco de produção aqui)
TEST_DATABASE_URL=postgresql+asyncpg://cityrain:cityrain@localhost:5433/cityrain_teste

# Chave de autenticação da Jetson (Bearer token)
API_KEY=troque_por_uma_chave_secreta_longa

# Chave de administrador para operações protegidas.
# Vazia = toda rota de admin responde 401.
ADMIN_KEY=

# Caminho do modelo ONNX de intensidade para câmera móvel (padrão: app/inference/modelos/intensidade.onnx)
INFERENCE_MODEL_PATH=

# Caminho do modelo ONNX de intensidade para câmera fixa (padrão: app/inference/modelos/intensidade_fixa.onnx)
INFERENCE_MODEL_FIXA_PATH=

# Diretório contendo imagens de referência para câmeras fixas: <nome_do_device>/{dia,noite}.jpg (padrão: app/inference/referencias)
REFERENCIAS_DIR=

# Diretório local onde as imagens da Jetson são salvas
UPLOAD_DIR=storage

# Origens permitidas no CORS (separadas por vírgula entre colchetes JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8501"]

# Tamanho máximo de upload em MB
MAX_UPLOAD_SIZE_MB=50
