# Aponta o dashboard para outra API (ex.: backend local em testes ponta a ponta).
# Sem isso, usa a API publicada no Railway.
VITE_API_URL=

# Não há chave de administração no frontend: tudo que o dashboard lê é público
# (inclusive GET /api/v1/devices/publico). Nunca coloque a ADMIN_KEY em variável VITE_ —
# ela iria para o JavaScript servido a qualquer visitante.
