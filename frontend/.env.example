# Aponta o dashboard para outra API (ex.: backend local em testes ponta a ponta).
# Sem isso, usa a API publicada no Railway.
VITE_API_URL=

# Chave de administração do backend — necessária apenas para a página
# /dispositivos (GET /api/v1/devices/ é protegido por verificar_admin_key).
# Sem ela, a página pede a configuração em vez de tentar a requisição.
# O mapa e as capturas do dashboard são endpoints públicos e não precisam dela.
VITE_ADMIN_API_KEY=
